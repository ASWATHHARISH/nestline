        "contract_version": {
          "const": "6.0.0",
          "default": "6.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "input_channel": {
          "enum": [
            "onboarding_symptom",
            "chat_message",
            "symptom_check_in",
            "extracted_document_fact",
            "plan_generation_input"
          ],
          "title": "Input Channel",
          "type": "string"
        },
        "content_origin": {
          "enum": [
            "user_text",
            "untrusted_document",
            "system_plan_input"
          ],
          "title": "Content Origin",
          "type": "string"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "jurisdiction": {
          "const": "IN",
          "default": "IN",
          "title": "Jurisdiction",
          "type": "string"
        },
        "requested_spec_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Spec Version"
        }
      },
      "required": [
        "input_channel",
        "content_origin",
        "text"
      ],
      "title": "SafetyGateInput",
      "type": "object"
