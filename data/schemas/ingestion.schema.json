{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "records": {
    "evidence_candidate": {
      "$defs": {
        "Applicability": {
          "additionalProperties": false,
          "description": "The complete time interval supported by a passage, not a guessed week.",
          "properties": {
            "stage": {
              "enum": [
                "possible_pregnancy",
                "pregnancy",
                "postpartum"
              ],
              "title": "Stage",
              "type": "string"
            },
            "unit": {
              "enum": [
                "week",
                "day",
                "none"
              ],
              "title": "Unit",
              "type": "string"
            },
            "start": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Start"
            },
            "end": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End"
            }
          },
          "required": [
            "stage",
            "unit"
          ],
          "title": "Applicability",
          "type": "object"
        },
        "DevelopmentMeasurement": {
          "additionalProperties": false,
          "description": "General source measurement; never a measurement from a user's report.",
          "properties": {
            "kind": {
              "enum": [
                "length",
                "weight"
              ],
              "title": "Kind",
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Value"
            },
            "minimum": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Minimum"
            },
            "maximum": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Maximum"
            },
            "unit": {
              "enum": [
                "mm",
                "cm",
                "m",
                "in",
                "g",
                "kg",
                "oz",
                "lb"
              ],
              "title": "Unit",
              "type": "string"
            },
            "basis": {
              "enum": [
                "general_source_range",
                "general_source_approximation"
              ],
              "title": "Basis",
              "type": "string"
            },
            "variability_notice": {
              "minLength": 1,
              "title": "Variability Notice",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "unit",
            "basis",
            "variability_notice"
          ],
          "title": "DevelopmentMeasurement",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "source_locator": {
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "source_block_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Source Block Ids",
          "type": "array"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "heading_path": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "original_text": {
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "normalized_search_text": {
          "minLength": 1,
          "title": "Normalized Search Text",
          "type": "string"
        },
        "original_text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Text Sha256",
          "type": "string"
        },
        "source_anchor_verified": {
          "title": "Source Anchor Verified",
          "type": "boolean"
        },
        "domains": {
          "items": {
            "enum": [
              "journey",
              "nutrition",
              "movement",
              "wellbeing",
              "symptoms",
              "preparation",
              "followup"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        },
        "display_slots": {
          "items": {
            "enum": [
              "hero",
              "kpi_development",
              "kpi_timing",
              "nutrition_focus",
              "movement_focus",
              "wellbeing_focus",
              "symptom_education",
              "preparation",
              "what_may_change",
              "consider",
              "avoid",
              "ask_a_professional",
              "followup"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Display Slots",
          "type": "array"
        },
        "applies_to": {
          "$ref": "#/$defs/Applicability"
        },
        "jurisdiction": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Jurisdiction",
          "type": "array"
        },
        "conditions_required": {
          "items": {
            "enum": [
              "breastfeeding",
              "early_home_recovery",
              "professional_care_for_postpartum_depression",
              "complicated_delivery_or_caesarean",
              "uncomplicated_delivery",
              "feels_ready_for_gentle_activity",
              "exercise_clearance",
              "movement_restriction",
              "current_warning_symptom",
              "home_birth",
              "facility_birth",
              "pregnancy_confirmed",
              "consents_to_wellbeing_activity",
              "persistent_emotional_concern",
              "trusted_support_available"
            ],
            "type": "string"
          },
          "title": "Conditions Required",
          "type": "array"
        },
        "conditions_excluded": {
          "items": {
            "enum": [
              "breastfeeding",
              "early_home_recovery",
              "professional_care_for_postpartum_depression",
              "complicated_delivery_or_caesarean",
              "uncomplicated_delivery",
              "feels_ready_for_gentle_activity",
              "exercise_clearance",
              "movement_restriction",
              "current_warning_symptom",
              "home_birth",
              "facility_birth",
              "pregnancy_confirmed",
              "consents_to_wellbeing_activity",
              "persistent_emotional_concern",
              "trusted_support_available"
            ],
            "type": "string"
          },
          "title": "Conditions Excluded",
          "type": "array"
        },
        "personal_fact_dependencies": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Personal Fact Dependencies",
          "type": "array"
        },
        "development_measurements": {
          "items": {
            "$ref": "#/$defs/DevelopmentMeasurement"
          },
          "title": "Development Measurements",
          "type": "array"
        },
        "linked_profile_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Linked Profile Ids",
          "type": "array"
        },
        "linked_fragment_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Linked Fragment Ids",
          "type": "array"
        },
        "linked_catalogue_item_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Linked Catalogue Item Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "rejected",
            "review_required",
            "approved"
          ],
          "title": "State",
          "type": "string"
        },
        "review_reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "candidate_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Checksum",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "evidence_id",
        "source_id",
        "artifact_sha256",
        "source_version",
        "source_locator",
        "original_text",
        "normalized_search_text",
        "original_text_sha256",
        "source_anchor_verified",
        "domains",
        "display_slots",
        "applies_to",
        "jurisdiction",
        "state",
        "candidate_checksum"
      ],
      "title": "EvidenceCandidate",
      "type": "object"
    },
    "evidence_review_task": {
      "additionalProperties": false,
      "description": "A pending human decision; its presence never counts as approval.",
      "properties": {
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "candidate_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Checksum",
          "type": "string"
        },
        "required_checks": {
          "items": {
            "enum": [
              "source_anchor",
              "domain",
              "stage_and_range",
              "wording",
              "jurisdiction",
              "conditions",
              "development_measurements",
              "profile_links",
              "catalogue_links",
              "reuse_and_attribution"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Checks",
          "type": "array"
        },
        "blocking_reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Blocking Reasons",
          "type": "array"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "task_id",
        "candidate_id",
        "evidence_id",
        "source_id",
        "candidate_checksum",
        "required_checks",
        "blocking_reasons"
      ],
      "title": "EvidenceReviewTask",
      "type": "object"
    },
