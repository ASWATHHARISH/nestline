{"fragment_id": "F-TEST", "domain": "preparation", "text": "Follow the instructions supplied with the home pregnancy test.", "applies_to": {"stage": "possible_pregnancy", "unit": "none", "start": null, "end": null}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-TEST"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-DATING", "domain": "journey", "text": "Pregnancy weeks are counted from the first day of the last normal menstrual period.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-DATING"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-FIRST-TRIMESTER", "domain": "journey", "text": "Mood changes can occur during the first trimester; experiences differ.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-FIRST-TRIMESTER"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-P24-DEVELOPMENT", "domain": "journey", "text": "The source describes bone marrow beginning to produce blood cells at 24 weeks.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 24, "end": 24}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-P24-DEVELOPMENT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-P36-DEVELOPMENT", "domain": "journey", "text": "The source describes increasing body fat at 36 weeks.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 36, "end": 36}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-P36-DEVELOPMENT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-FOOD-HYGIENE", "domain": "nutrition", "text": "Wash fruit and vegetables before eating them.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-FOOD-HYGIENE"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-MOVEMENT-CONSULT", "domain": "movement", "text": "Discuss exercise during pregnancy with your doctor or midwife before starting.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-MOVEMENT-CONSULT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-REST", "domain": "preparation", "text": "Use opportunities to rest when the baby sleeps.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 1}, "jurisdiction": ["US"], "evidence_span_ids": ["E-PP-REST"], "status": "draft", "review": null, "conditions_required": ["early_home_recovery"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-ACTIVITY-QUESTION", "domain": "followup", "text": "Ask your care professional about returning to your usual activities.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 6, "end": 6}, "jurisdiction": ["US"], "evidence_span_ids": ["E-PP-ACTIVITY-QUESTION"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-SUPPORT-CONTEXT", "domain": "wellbeing", "text": "Self-care support accompanies professional care; it does not replace it.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["US"], "evidence_span_ids": ["E-PP-SUPPORT-CONTEXT"], "status": "draft", "review": null, "conditions_required": ["professional_care_for_postpartum_depression"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-SUPPORT-TALK", "domain": "wellbeing", "text": "Alongside professional care, consider sharing your feelings with someone supportive.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["US"], "evidence_span_ids": ["E-PP-SUPPORT-CONTEXT", "E-PP-SUPPORT-TALK"], "status": "draft", "review": null, "conditions_required": ["professional_care_for_postpartum_depression"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-P09-DEVELOPMENT", "domain": "journey", "text": "The eyes, mouth and tongue are forming.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 9, "end": 9}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-P09-DEVELOPMENT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-P10-DEVELOPMENT", "domain": "journey", "text": "The embryo is now known as a fetus and is about 2.5 cm in length.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 10, "end": 10}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-P10-DEVELOPMENT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-IN-FOOD", "domain": "nutrition", "text": "Include a variety of locally available seasonal foods, vegetables and fruit.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-FOOD"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-REST-PREG", "domain": "movement", "text": "Share demanding tasks with others and avoid overexerting yourself.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-REST-PREG"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-REST-PP", "domain": "preparation", "text": "Make space for rest while recovering after birth.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 6}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-REST-PP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-TEST-SUPPORT", "domain": "followup", "text": "Ask your local maternal-health worker about pregnancy testing support.", "applies_to": {"stage": "possible_pregnancy", "unit": "none", "start": null, "end": null}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-TEST-SUPPORT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-BIRTH-PLAN", "domain": "preparation", "text": "Discuss birth preparation and your choice of a birth companion with your care team.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-BIRTH-PLAN"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PP-FOLLOWUP", "domain": "followup", "text": "The NHM booklet includes a postnatal home visit on day 42 for both facility and home births.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 6, "end": 6}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PP-FOLLOWUP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-TALK", "domain": "wellbeing", "text": "You can talk about how you feel with someone supportive or your care professional.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-TALK"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-ENJOY", "domain": "wellbeing", "text": "Try to leave some time for an activity you enjoy.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-ENJOY"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-FERTILITY", "domain": "journey", "text": "Pregnancy can become possible again from about three weeks after birth.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 3, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-FERTILITY"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-FERTILITY-FEEDING", "domain": "journey", "text": "Breastfeeding does not automatically rule out another pregnancy.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 3, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-FERTILITY"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-DIET", "domain": "nutrition", "text": "You do not need to follow a special diet while you're breastfeeding.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-DIET"], "status": "draft", "review": null, "conditions_required": ["breastfeeding"], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-PP-MOVEMENT-QUESTION", "domain": "movement", "text": "After a complicated delivery or caesarean, ask your care professional before starting strenuous activity.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-MOVEMENT-QUESTION"], "status": "draft", "review": null, "conditions_required": ["complicated_delivery_or_caesarean"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-MIND-REST", "domain": "wellbeing", "text": "Allow yourself time to rest as part of caring for your wellbeing.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-MIND-REST"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-MIND-TALK", "domain": "wellbeing", "text": "Talk with someone supportive about how you are feeling.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-MIND-TALK"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-PRACTICAL-HELP", "domain": "preparation", "text": "Tell a trusted, supportive person what practical help would be useful to you.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-PRACTICAL-HELP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-REGISTRATION", "domain": "followup", "text": "The NHM booklet calls for pregnancy registration in the first trimester.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-REGISTRATION"], "status": "draft", "review": null, "conditions_required": ["pregnancy_confirmed"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-ANC-VISITS", "domain": "followup", "text": "The NHM CHO booklet describes four antenatal checks in the Village Health Sanitation and Nutrition Day programme.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-ANC-VISITS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-ANC-TESTS", "domain": "followup", "text": "The NHM booklet lists urine, haemoglobin, syphilis, HIV and blood-group tests in antenatal care.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-ANC-TESTS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-FOOD-DAIRY", "domain": "nutrition", "text": "The NHM booklet lists milk, curd, buttermilk and paneer as sources of calcium and protein.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-FOOD-DAIRY"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-FOOD-GRAINS", "domain": "nutrition", "text": "Cereals, whole grains and pulses are good sources of proteins.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-FOOD-GRAINS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-IN-FOOD-GREENS", "domain": "nutrition", "text": "Green leafy vegetables are a rich source of iron and folic acid.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-FOOD-GREENS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-IN-FOOD-ANIMAL", "domain": "nutrition", "text": "For non-vegetarians, meat, egg, chicken or fish are good sources of proteins, vitamins and iron.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-FOOD-ANIMAL"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-IN-FOOD-PLANTS", "domain": "nutrition", "text": "The booklet includes soya beans, grains, seeds and nuts among protein-source examples.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-FOOD-PLANTS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-FOOD-SAFETY", "domain": "nutrition", "text": "Wash produce and utensils, cook meat completely, and keep raw meat separate from other food.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-FOOD-SAFETY"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-FOOD-AVOID", "domain": "nutrition", "text": "The source advises avoiding unpasteurised milk or juice and raw sprouts during pregnancy.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-FOOD-AVOID"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-MEDICINE-BOUNDARY", "domain": "preparation", "text": "Speak with your doctor before starting or stopping a medicine.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-MEDICINE-BOUNDARY"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-MOVEMENT-OPTIONS", "domain": "movement", "text": "After discussing suitability with your care professional, walking or swimming may be options for moderate, low-impact activity.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-MOVEMENT-OPTIONS"], "status": "draft", "review": null, "conditions_required": ["exercise_clearance"], "conditions_excluded": ["movement_restriction", "current_warning_symptom"], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-MOVEMENT-PACE", "domain": "movement", "text": "Start slowly, build up gradually, and take breaks. You should be able to talk during activity.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-MOVEMENT-PACE"], "status": "draft", "review": null, "conditions_required": ["exercise_clearance"], "conditions_excluded": ["movement_restriction", "current_warning_symptom"], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-MOVEMENT-STOP", "domain": "symptoms", "text": "Stop activity and seek medical advice if warning symptoms such as chest pain, bleeding, fluid leakage or reduced fetal movement occur.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-MOVEMENT-STOP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-GENTLE-MOVEMENT", "domain": "movement", "text": "After a straightforward birth, gentle walking or stretches may be options when you feel ready.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-GENTLE-MOVEMENT"], "status": "draft", "review": null, "conditions_required": ["uncomplicated_delivery", "feels_ready_for_gentle_activity"], "conditions_excluded": ["movement_restriction", "current_warning_symptom", "complicated_delivery_or_caesarean"], "presentation": "paraphrase"}
{"fragment_id": "F-PP-PERSISTENT-CONCERN", "domain": "wellbeing", "text": "If you are worried about how you feel or are struggling to cope, talk to a care professional.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-PERSISTENT-CONCERN"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-ASK-HELP", "domain": "wellbeing", "text": "You can make room for rest and accept practical help from people you trust.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-ASK-HELP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PP-DAY0", "domain": "followup", "text": "The booklet calls for a health-worker check for mother and baby on the day of birth.", "applies_to": {"stage": "postpartum", "unit": "day", "start": 0, "end": 0}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PP-DAY0"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PP-DAY-REST", "domain": "preparation", "text": "Make space for rest during recovery.", "applies_to": {"stage": "postpartum", "unit": "day", "start": 0, "end": 7}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PP-DAY-REST"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PP-DAY-HELP", "domain": "symptoms", "text": "Take immediate medical help if any complication occurs in yourself or your baby.", "applies_to": {"stage": "postpartum", "unit": "day", "start": 0, "end": 7}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PP-DAY-HELP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-IN-PNC-DAYS", "domain": "followup", "text": "The NHM programme lists different early home-visit schedules for facility and home births.", "applies_to": {"stage": "postpartum", "unit": "day", "start": 0, "end": 7}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PNC-DAYS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PNC-WEEKS", "domain": "followup", "text": "The NHM programme lists postnatal home visits through day 42, with an additional day-1 visit after a home birth.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 6}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PNC-WEEKS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PNC-DAY1", "domain": "followup", "text": "The NHM programme includes a day-1 home visit after a home birth.", "applies_to": {"stage": "postpartum", "unit": "day", "start": 1, "end": 1}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PNC-DAY1"], "status": "draft", "review": null, "conditions_required": ["home_birth"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PNC-DAY3", "domain": "followup", "text": "The NHM programme includes a day-3 home visit after either a facility or home birth.", "applies_to": {"stage": "postpartum", "unit": "day", "start": 3, "end": 3}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PNC-DAY3"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PNC-DAY7", "domain": "followup", "text": "The NHM programme includes a day-7 home visit after either a facility or home birth.", "applies_to": {"stage": "postpartum", "unit": "day", "start": 7, "end": 7}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PNC-DAY7"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PMSMA", "domain": "followup", "text": "PMSMA offers antenatal care on the 9th of each month at designated government facilities during the second and third trimesters.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 13, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PMSMA"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PREG-WARNINGS", "domain": "symptoms", "text": "The booklet calls for immediate help for pregnancy danger signs, including breathlessness, bleeding, severe abdominal pain, fever or convulsions.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 4, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PREG-WARNINGS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PP-WARNINGS", "domain": "symptoms", "text": "The booklet identifies post-birth problems requiring referral, including excessive bleeding, difficulty breathing, blurred vision or fits, fever and fainting.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PP-WARNINGS"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
