{"fragment_id": "F-TEST", "domain": "preparation", "text": "Follow the instructions supplied with the home pregnancy test.", "applies_to": {"stage": "possible_pregnancy", "unit": "none", "start": null, "end": null}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-TEST"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-DATING", "domain": "journey", "text": "Gestational dating counts from the first day of the last normal menstrual period.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-DATING"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-FIRST-TRIMESTER", "domain": "journey", "text": "Mood changes can occur during the first trimester; experiences differ.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-FIRST-TRIMESTER"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-P24-DEVELOPMENT", "domain": "journey", "text": "The source describes bone marrow beginning to produce blood cells at 24 weeks.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 24, "end": 24}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-P24-DEVELOPMENT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-P36-DEVELOPMENT", "domain": "journey", "text": "The source describes increasing body fat at 36 weeks.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 36, "end": 36}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-P36-DEVELOPMENT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-FOOD-HYGIENE", "domain": "nutrition", "text": "Wash fruit and vegetables before eating them.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-FOOD-HYGIENE"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-MOVEMENT-CONSULT", "domain": "movement", "text": "Discuss exercise during pregnancy with your doctor or midwife before starting.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-MOVEMENT-CONSULT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-REST", "domain": "preparation", "text": "Use opportunities to rest when the baby sleeps.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 1}, "jurisdiction": ["US"], "evidence_span_ids": ["E-PP-REST"], "status": "draft", "review": null, "conditions_required": ["early_home_recovery"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-ACTIVITY-QUESTION", "domain": "followup", "text": "Ask your care professional about returning to your usual activities.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 6, "end": 6}, "jurisdiction": ["US"], "evidence_span_ids": ["E-PP-ACTIVITY-QUESTION"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-SUPPORT-CONTEXT", "domain": "wellbeing", "text": "Self-care support accompanies professional care; it does not replace it.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["US"], "evidence_span_ids": ["E-PP-SUPPORT-CONTEXT"], "status": "draft", "review": null, "conditions_required": ["professional_care_for_postpartum_depression"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-SUPPORT-TALK", "domain": "wellbeing", "text": "Alongside professional care, consider sharing your feelings with someone supportive.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["US"], "evidence_span_ids": ["E-PP-SUPPORT-CONTEXT", "E-PP-SUPPORT-TALK"], "status": "draft", "review": null, "conditions_required": ["professional_care_for_postpartum_depression"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-P09-DEVELOPMENT", "domain": "journey", "text": "The eyes, mouth and tongue are forming.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 9, "end": 9}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-P09-DEVELOPMENT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-P10-DEVELOPMENT", "domain": "journey", "text": "The embryo is now known as a fetus and is about 2.5 cm in length.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 10, "end": 10}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-P10-DEVELOPMENT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "quotation"}
{"fragment_id": "F-IN-FOOD", "domain": "nutrition", "text": "Include a variety of locally available seasonal foods, vegetables and fruit.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-FOOD"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-REST-PREG", "domain": "movement", "text": "Share demanding tasks with others and avoid overexerting yourself.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-REST-PREG"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-REST-PP", "domain": "preparation", "text": "Make space for rest while recovering after birth.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 6}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-REST-PP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-TEST-SUPPORT", "domain": "followup", "text": "Ask your local maternal-health worker about pregnancy testing support.", "applies_to": {"stage": "possible_pregnancy", "unit": "none", "start": null, "end": null}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-TEST-SUPPORT"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-BIRTH-PLAN", "domain": "preparation", "text": "Discuss birth preparation and your choice of a birth companion with your care team.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-BIRTH-PLAN"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-IN-PP-FOLLOWUP", "domain": "followup", "text": "Check your postnatal follow-up arrangements with your ASHA or ANM around day 42.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 6, "end": 6}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-IN-PP-FOLLOWUP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-TALK", "domain": "wellbeing", "text": "You can talk about how you feel with someone supportive or your care professional.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-TALK"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PREG-ENJOY", "domain": "wellbeing", "text": "Try to leave some time for an activity you enjoy.", "applies_to": {"stage": "pregnancy", "unit": "week", "start": 1, "end": 42}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PREG-ENJOY"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-FERTILITY", "domain": "journey", "text": "Pregnancy can become possible again from about three weeks after birth.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 3, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-FERTILITY"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-FERTILITY-FEEDING", "domain": "journey", "text": "Breastfeeding does not automatically rule out another pregnancy.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 3, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-FERTILITY-FEEDING"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-DIET", "domain": "nutrition", "text": "Breastfeeding alone does not require a special diet; keep any personal dietary restrictions agreed with your care team.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-DIET"], "status": "draft", "review": null, "conditions_required": ["breastfeeding"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-MOVEMENT-QUESTION", "domain": "movement", "text": "After a complicated delivery or caesarean, ask your care professional before starting strenuous activity.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-MOVEMENT-QUESTION"], "status": "draft", "review": null, "conditions_required": ["complicated_delivery_or_caesarean"], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-MIND-REST", "domain": "wellbeing", "text": "Allow yourself time to rest as part of caring for your wellbeing.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-MIND-REST"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-MIND-TALK", "domain": "wellbeing", "text": "Talk with someone supportive about how you are feeling.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-MIND-TALK"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
{"fragment_id": "F-PP-PRACTICAL-HELP", "domain": "preparation", "text": "Tell a trusted, supportive person what practical help would be useful to you.", "applies_to": {"stage": "postpartum", "unit": "week", "start": 1, "end": 12}, "jurisdiction": ["IN"], "evidence_span_ids": ["E-PP-PRACTICAL-HELP"], "status": "draft", "review": null, "conditions_required": [], "conditions_excluded": [], "presentation": "paraphrase"}
