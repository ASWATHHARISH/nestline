# Public client configuration. Copy this file to .env and fill it locally.
# The publishable key is protected by database RLS; it is not an admin key.
NESTLINE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NESTLINE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Local Supabase CLI/deployment credentials. Never expose these to the app.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# OpenAI access. Exact generation and embedding models remain gated by the
# provider benchmark; this key only establishes available API access.
OPENAI_API_KEY=

# Stage 4 structured document extraction. Choose an exact model and cost ceiling
# from a measured fictional-data benchmark; there is deliberately no default.
# Keep false in any public deployment. Enable only for supervised fictional demos.
NESTLINE_ENABLE_STAGE4_FIXTURE_DEMO=false
NESTLINE_DOCUMENT_PROVIDER=openai
NESTLINE_DOCUMENT_MODEL=
NESTLINE_DOCUMENT_MAX_COST_USD=

# Real medical uploads stay disabled while the scanner value is unavailable. A
# future scanner adapter and endpoint require a security/platform decision.
NESTLINE_UPLOAD_SCANNER=unavailable
NESTLINE_UPLOAD_SCAN_ENDPOINT=

NESTLINE_EMBEDDING_API_KEY=
NESTLINE_EMBEDDING_PROVIDER=
NESTLINE_EMBEDDING_URL=
NESTLINE_EMBEDDING_MODEL=

# LangSmith tracing/evaluation. Only synthetic or redacted data may be traced.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nestline-dev
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Do not place a Supabase service-role/secret key in this file. If a later
# admin-only ingestion job needs one, configure it in the hosting secret store.
