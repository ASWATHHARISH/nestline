# Public client configuration. Copy this file to .env and fill it locally.
# The publishable key is still protected by database RLS; it is not an admin key.
NESTLINE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NESTLINE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Stage 5 model/embedding provider configuration. Leave unset until the team
# selects and records an exact provider/model after the planned smoke benchmark.
NESTLINE_EMBEDDING_API_KEY=
NESTLINE_EMBEDDING_PROVIDER=
NESTLINE_EMBEDDING_URL=
NESTLINE_EMBEDDING_MODEL=

# Later trace/evaluation integration. Traces must contain synthetic or redacted data.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nestline-dev

# Do not place a Supabase service-role key in this file. If a later admin-only
# ingestion job needs one, configure it only in that server/hosting secret store.
